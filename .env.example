# Base URL of the deployed AWS API Gateway endpoint
# Example: VITE_API_BASE_URL=https://abc123xyz.execute-api.ap-southeast-2.amazonaws.com/prod
# Leave empty to automatically use local development mock data fallback
VITE_API_BASE_URL=

# AWS Credentials (required for e2e verification scripts)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-southeast-2
S3_BUCKET=your-s3-bucket-name
